cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Next.js
.next/
out/

# Production
build/
dist/

# Environment files
.env
.env.*
!.env.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
playwright-report/
test-results/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Local temp / cache
.cache/
tmp/
temp/
*.tmp

# Generated / local asset work
assets-source/
renders/
exports/

# Python artifacts if used for asset tooling
__pycache__/
*.py[cod]
.venv/
venv/

# Local Claude state
.claude/settings.local.json

# Secrets / certificates
*.pem
EOF